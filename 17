int divisorSubstrings(int num, int k) {
    int t=num,c=0,i=0,x,ans=0;
    while(t)
    {
        t/=10;
        c++;
    }
    t=num;
    char str[c+1];
    while(num)
    {
        str[c-i-1]=num%10+'0';
        num/=10;
        i++;
    }
    str[c]='\0';
    int len=k;
    for(i=0;i<c+1;i++)
    {
        if(i+k<c+1)
        {
            x=0;
            int j=i;
            while(j<c+1 && k--)
            {
                x=x*10+str[j]-'0';
                j++;
            }
            if(x!=0 && t%x==0)
            ans++;
            k=len;
        }
    }
    return ans;
}
